package SauceDemo;

import java.io.IOException;

import org.testng.Assert;
import org.testng.annotations.Test;

import BaseClass.BaseTest;
import GenericUtilities.ExcelUtility;
import POM.CartPage;
import POM.CheckoutOverviewPage;
import POM.CheckoutPage;
import POM.Login;
import POM.ProductsPage;

public class SauceDemoTest extends BaseTest {

    Login loginPage;
    ProductsPage productsPage;
    CartPage cartPage;
    CheckoutPage checkoutPage;
    CheckoutOverviewPage overviewPage;

    ExcelUtility excelUtil;

    // TEST CASE 1 : LOGIN TEST

    @Test(priority = 1)
    public void loginTest() {

        // Get username and password from property file

        String username = pUtil.getDataFromProperties("username");
        String password =  pUtil.getDataFromProperties("password");

        // Create Login POM object
        loginPage = new Login(driver);

        // Login
        loginPage.login(username, password);

        // Create Products Page object
        productsPage = new ProductsPage(driver);

        // Verify Products page
        Assert.assertTrue( productsPage.isProductsPageDisplayed(), "Products page is not displayed");
        System.out.println( "Login Test Passed");
        System.out.println( "Products page is displayed");
    }

    // TEST CASE 2 : ORDER PLACEMENT TEST

    @Test( priority = 2, dependsOnMethods = "loginTest" )
    public void orderPlacementTest() throws IOException {

        // Create Excel object
        excelUtil =  new ExcelUtility();

        // Read First Name
        String firstName =  excelUtil.getDataFromExcel( "SauceDemo", 1, 0 );

        // Read Last Name
        String lastName = excelUtil.getDataFromExcel( "SauceDemo", 1, 1 );

        // Read Postal Code
        String postalCode = excelUtil.getDataFromExcel( "SauceDemo", 1, 2 );

        // Add Sauce Labs Backpack
        productsPage = new ProductsPage(driver);
        productsPage.addBackpackToCart();

        // Verify Cart Contains 1 Item
        String cartCount =  productsPage.getCartItemCount();
        Assert.assertEquals( cartCount, "1",  "Cart does not contain 1 item" );
        System.out.println( "Cart contains 1 item");

        // Open Cart
        productsPage.clickCart();

        // Verify Backpack
        cartPage =  new CartPage(driver);
        Assert.assertTrue( cartPage.isBackpackDisplayed(),  "Sauce Labs Backpack is not displayed" );
        System.out.println("Sauce Labs Backpack is displayed");

        // Click Checkout
        cartPage.clickCheckout();

        // Enter First Name, Last Name, Postal Code
        checkoutPage = new CheckoutPage(driver);
        checkoutPage.enterDetails( firstName, lastName, postalCode);

        // Verify Checkout: Overview
        overviewPage = new CheckoutOverviewPage(driver);
        Assert.assertTrue( overviewPage.isOverviewPageDisplayed(), "Checkout: Overview page is not displayed");
        System.out.println( "Checkout: Overview page is displayed");

        // Click Finish
        overviewPage.clickFinish();

        // Verify Thank You Message
        String actualMessage = overviewPage.getThankYouMessage();
        Assert.assertEquals(actualMessage, "Thank you for your order!", "Order confirmation message is incorrect");
        System.out.println("Thank you for your order!");
    }
}


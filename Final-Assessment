package TestScripts1;

import java.io.IOException;
import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import org.testng.Assert;
import org.testng.annotations.Test;

import BaseClass.BaseTest;
import POM1.BuzzPage;
import POM1.HomePage;
import POM1.LoginPage;

public class BuzZTest extends BaseTest {

    @Test
    public void buzzTest() throws IOException {

        // READ DATA FROM EXCEL
        String username = getDataFromExcel("Login", 1, 0);
        String password = getDataFromExcel("Login", 1, 1);
        String postText = getDataFromExcel( "Buzz", 1, 0);

        // WAIT
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));

        // LOGIN
        LoginPage loginPage = new LoginPage(driver);
        wait.until(ExpectedConditions .visibilityOfElementLocated( By.name("username")));
        loginPage.login(username,password);
        System.out.println("Login successful");

        // CLICK BUZZ
        HomePage homePage = new HomePage(driver);
        wait.until(ExpectedConditions.elementToBeClickable(By.xpath("//span[normalize-space()='Buzz']")));
        homePage.clickBuzz();
        System.out.println("Buzz page opened");

        // ENTER POST
        BuzzPage buzzPage = new BuzzPage(driver);
        wait.until(ExpectedConditions .visibilityOfElementLocated(By.xpath("//textarea[@placeholder=\"What's on your mind?\"]")));
        buzzPage.enterPost(postText);
        System.out.println("Post entered successfully");

        // CLICK POST
        wait.until(ExpectedConditions.elementToBeClickable(By.xpath("//button[normalize-space()='Post']")));
        buzzPage.clickPost();
        System.out.println("Post button clicked");

        // VERIFY RECENT POST
        boolean postDisplayed = wait.until(driver -> buzzPage.verifyPost(postText));
        Assert.assertTrue(postDisplayed,"Post was not displayed in Recent Posts");
        System.out.println("PASS: Post displayed in Recent Posts");

     // LOGOUT
     buzzPage.logout();
     System.out.println( "Logout button clicked");

     // VERIFY LOGOUT
     wait.until( ExpectedConditions .urlContains("/auth/login"));
     System.out.println( "Login page displayed");

     // Verify username field
     wait.until( ExpectedConditions .visibilityOfElementLocated( By.name("username")));
     Assert.assertTrue( driver.findElement(By.name("username")).isDisplayed(), "Logout failed");
     System.out.println( "PASS: Logout successful");
    }
}






package POM1;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class BuzzPage {

    WebDriver driver;
    WebDriverWait wait;

    // Text area
    By textArea = By.xpath("//textarea[@placeholder=\"What's on your mind?\"]");

    // Post button
    By postButton = By.xpath("//button[normalize-space()='Post']");

    // User dropdown
    By userDropdown = By.cssSelector("span.oxd-userdropdown-tab");

    // Logout
    By logoutButton = By.xpath("//a[normalize-space()='Logout']");

    // Constructor
    public BuzzPage(WebDriver driver) {
        this.driver = driver;
        wait = new WebDriverWait(driver, Duration.ofSeconds(15));
    }

    // Enter post
    public void enterPost(String text) {
        driver.findElement(textArea).sendKeys(text);
    }

    // Click Post
    public void clickPost() {
        driver.findElement(postButton).click();
    }

    // Verify post
    public boolean verifyPost(String text) {
        By post = By.xpath("//*[contains(normalize-space(),\"" + text + "\")]");
        return driver.findElements(post).size() > 0;
    }

    // Logout
    public void logout() {

        // Click user dropdown
        wait.until(ExpectedConditions .elementToBeClickable(userDropdown)) .click();

        // Click Logout
        wait.until(ExpectedConditions .elementToBeClickable(logoutButton)).click();
    }
}


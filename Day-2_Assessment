package Assessment;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class FacebookTestCase2 {

    public static void main(String[] args) throws InterruptedException {

        WebDriver driver = new ChromeDriver();

        driver.manage().window().maximize();

        WebDriverWait wait = new WebDriverWait(
                driver, Duration.ofSeconds(15));

        driver.get("https://www.facebook.com/");

        WebElement createAccount = wait.until(
                ExpectedConditions.elementToBeClickable(
                        By.xpath("//a[normalize-space()='Create new account']")));

        System.out.println("Create New Account Button Location");

        System.out.println("X Coordinate : "
                + createAccount.getLocation().getX());

        System.out.println("Y Coordinate : "
                + createAccount.getLocation().getY());

        createAccount.click();

        Thread.sleep(2000);
        WebElement email = wait.until(ExpectedConditions.visibilityOfElementLocated(By.xpath("//input[@placeholder='Mobile number or email address']")));

        System.out.println();
        System.out.println("Before Entering Email");

        System.out.println("DOM Attribute : " + email.getDomAttribute("value"));

        System.out.println("DOM Property : " + email.getDomProperty("value"));

        email.sendKeys("test123@gmail.com");

        System.out.println();
        System.out.println("After Entering Email");

        System.out.println("DOM Attribute : " + email.getDomAttribute("value"));

        System.out.println("DOM Property : " + email.getDomProperty("value"));

        WebElement signUp = wait.until( ExpectedConditions.visibilityOfElementLocated(By.xpath("//button[normalize-space()='Sign Up']")));

        System.out.println();
        System.out.println("Sign Up Button Size");

        System.out.println("Width : " + signUp.getSize().getWidth());

        System.out.println("Height : " + signUp.getSize().getHeight());

        System.out.println();
        System.out.println("Sign Up Button CSS Properties");

        System.out.println("Font Size : "  + signUp.getCssValue("font-size"));

        System.out.println("Font Color : " + signUp.getCssValue("color"));

        System.out.println("Font Family : " + signUp.getCssValue("font-family"));

        System.out.println("Background Color : " + signUp.getCssValue("background-color"));

        System.out.println("Font Weight : " + signUp.getCssValue("font-weight"));

    }
}


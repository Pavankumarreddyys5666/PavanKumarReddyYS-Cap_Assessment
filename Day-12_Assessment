package TestScripts;

import java.io.FileInputStream;
import java.io.IOException;

import org.apache.poi.EncryptedDocumentException;
import org.apache.poi.ss.usermodel.DataFormatter;
import org.apache.poi.ss.usermodel.Sheet;
import org.apache.poi.ss.usermodel.Workbook;
import org.apache.poi.ss.usermodel.WorkbookFactory;
import org.testng.Assert;
import org.testng.annotations.Test;

import GenericUtilities.BaseClass;
import ObjectRepository.AddVacancyPage;
import ObjectRepository.HomePage;
import ObjectRepository.LoginPage;
import ObjectRepository.RecruitmentPage;

public class AddVacancyTest extends BaseClass {

    @Test
    public void addVacancyTest()throws EncryptedDocumentException, IOException {

        // LOGIN
        LoginPage loginPage = new LoginPage(driver);
        loginPage.login(fileUtil.getDataFromProperties("username"),fileUtil.getDataFromProperties("password"));

        // HOME PAGE
        HomePage homePage = new HomePage(driver);
        homePage.clickRecruitment();

        // RECRUITMENT PAGE
        RecruitmentPage recruitmentPage = new RecruitmentPage(driver);
        recruitmentPage.clickVacancies();

        // ADD VACANCY PAGE
        AddVacancyPage vacancyPage = new AddVacancyPage(driver);
        vacancyPage.clickAdd();

        // READ DATA FROM EXCEL
        FileInputStream excel = new FileInputStream( "./src/test/resources/HRMVacancy-1.xlsx");
        Workbook wb = WorkbookFactory.create(excel);
        Sheet sh = wb.getSheet("Sheet1");

        // A - Vacancy Name
        String vacancyName = sh.getRow(1).getCell(0).getStringCellValue();

        // B - Job Title
        String jobTitle = sh.getRow(1).getCell(1).getStringCellValue();

        // C - Description
        String description = sh.getRow(1).getCell(2).getStringCellValue();

        // D - Hiring Manager
        String hiringManager = sh.getRow(1).getCell(3).getStringCellValue();

        // E - Positions
        DataFormatter formatter = new DataFormatter();

        String positions = formatter.formatCellValue( sh.getRow(1).getCell(4));

        // Close Excel
        wb.close();
        excel.close();

        // ENTER VACANCY NAME
        vacancyPage.enterVacancyName(vacancyName);
        
        // SELECT JOB TITLE
        vacancyPage.selectJobTitle(jobTitle);

        // ENTER DESCRIPTION
        vacancyPage.enterDescription(description);

        // SELECT HIRING MANAGER
        vacancyPage.selectHiringManager(hiringManager);

        // ENTER NUMBER OF POSITIONS
        vacancyPage.enterNumberOfPositions(positions);
        
        // SAVE
        vacancyPage.clickSave();

        // VALIDATION
        Assert.assertTrue(driver.getCurrentUrl().contains("recruitment"), "Vacancy was not saved");
        System.out.println("Vacancy created successfully");
    }
}


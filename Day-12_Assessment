package ObjectRepository;

import java.time.Duration;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.FindBy;
import org.openqa.selenium.support.PageFactory;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class MyInfoPage {

    WebDriver driver;
    WebDriverWait wait;
    public MyInfoPage(WebDriver driver) {
        this.driver = driver;
        wait = new WebDriverWait( driver, Duration.ofSeconds(20));
        PageFactory.initElements( driver,this);
    }

    // FIRST NAME
    @FindBy(name = "firstName")
    private WebElement firstNameTF;

    // LAST NAME
    @FindBy(name = "lastName")
    private WebElement lastNameTF;

    // EMPLOYEE ID
    @FindBy(xpath = "//label[normalize-space()='Employee Id']" + "/../following-sibling::div//input")
    private WebElement employeeIdTF;

    // PERSONAL DETAILS SAVE BUTTON
    @FindBy(xpath = "//h6[normalize-space()='Personal Details']" + "/ancestor::div[contains(@class,'orangehrm-card-container')]" + "//button[@type='submit']")
    private WebElement personalDetailsSaveButton;

    // ENTER FIRST NAME
    public void enterFirstName(String firstName) {
        wait.until(ExpectedConditions.visibilityOf(firstNameTF));
        firstNameTF.clear();
        firstNameTF.sendKeys(firstName);
    }

    // ENTER LAST NAME
    public void enterLastName(String lastName) {
        wait.until(ExpectedConditions.visibilityOf(lastNameTF));
        lastNameTF.clear();
        lastNameTF.sendKeys(lastName);
    }

    // ENTER EMPLOYEE ID
    public void enterEmployeeId(String employeeId) {
        wait.until( ExpectedConditions.visibilityOf( employeeIdTF));
        employeeIdTF.clear();
        employeeIdTF.sendKeys(employeeId);
    }
    
    // CLICK SAVE
    public void clickSave() {
        wait.until( ExpectedConditions.visibilityOf( personalDetailsSaveButton));

        // Scroll Save button to center of screen
        ((JavascriptExecutor) driver).executeScript( "arguments[0].scrollIntoView({block:'center'});",personalDetailsSaveButton);
        wait.until( ExpectedConditions.elementToBeClickable( personalDetailsSaveButton));
        try {
            personalDetailsSaveButton.click();
        } catch (Exception e) {

            // JavaScript fallback
            ((JavascriptExecutor) driver).executeScript("arguments[0].click();", personalDetailsSaveButton);
        }
    }


    // GET FIRST NAME
    public String getFirstName() {
        wait.until( ExpectedConditions.visibilityOf(firstNameTF));
        return firstNameTF.getAttribute("value");
    }

    // GET LAST NAME
    public String getLastName() {
        wait.until(ExpectedConditions.visibilityOf(lastNameTF));
        return lastNameTF.getAttribute("value");
    }

    // GET EMPLOYEE ID
    public String getEmployeeId() {
        wait.until( ExpectedConditions.visibilityOf( employeeIdTF));
        return employeeIdTF.getAttribute("value");
    }
}


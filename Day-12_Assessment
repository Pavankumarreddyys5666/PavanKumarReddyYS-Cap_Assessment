package GenericUtilities;

import java.io.IOException;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.testng.annotations.AfterClass;
import org.testng.annotations.BeforeClass;
import org.testng.annotations.BeforeSuite;
import org.testng.annotations.AfterSuite;

public class BaseClass {

    protected WebDriver driver;

    protected FileUtility fileUtil = new FileUtility();

    protected ExcelUtility excelUtil = new ExcelUtility();

    protected WebDriverUtility webUtil = new WebDriverUtility();

    @BeforeSuite
    public void beforeSuite() {

        System.out.println("===== ORANGE HRM TEST SUITE STARTED =====");
    }

    @BeforeClass
    public void setUp() throws IOException {

        String browser = fileUtil.getDataFromProperties("browser");

        if (browser.equalsIgnoreCase("chrome")) {

            driver = new ChromeDriver();

        } else {

            throw new RuntimeException( "Unsupported browser: " + browser);
        }

        webUtil.maximizeWindow(driver);

        webUtil.waitForPageLoad(driver);

        driver.get( fileUtil.getDataFromProperties("url"));
    }

    @AfterClass
    public void tearDown() {

        if (driver != null) {

            driver.quit();
        }
    }

    @AfterSuite
    public void afterSuite() {

        System.out.println( "===== ORANGE HRM TEST SUITE COMPLETED =====");
    }
}



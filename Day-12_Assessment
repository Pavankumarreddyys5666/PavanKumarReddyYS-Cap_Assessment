package TestScripts;

import java.io.IOException;

import org.apache.poi.EncryptedDocumentException;
import org.testng.Assert;
import org.testng.annotations.Test;

import GenericUtilities.BaseClass;
import ObjectRepository.HomePage;
import ObjectRepository.LoginPage;
import ObjectRepository.MyInfoPage;

public class EditMyInfoTest extends BaseClass {

    @Test
    public void editMyInfoTest() throws EncryptedDocumentException, IOException {

        // LOGIN

        LoginPage loginPage = new LoginPage(driver);

        String username =  fileUtil.getDataFromProperties( "username");

        String password = fileUtil.getDataFromProperties( "password");

        loginPage.login( username,  password);

        // MY INFO

        HomePage homePage =  new HomePage(driver);

        homePage.clickMyInfo();

        MyInfoPage myInfoPage =  new MyInfoPage(driver);

        // Read data from Excel

        String firstName =  excelUtil.getDataFromExcel( "MyInfo", 1, 0);

        String lastName = excelUtil.getDataFromExcel( "MyInfo", 1,  1);

        String employeeId = excelUtil.getDataFromExcel( "MyInfo", 1, 2);

        // EDIT DETAILS

        myInfoPage.enterFirstName( firstName);

        myInfoPage.enterLastName( lastName);

        myInfoPage.enterEmployeeId( employeeId);

        // Save
        myInfoPage.clickSave();

        System.out.println( "Employee details saved");

        // LOGOUT

        homePage.logout();

        // LOGIN AGAIN

        loginPage.login( username, password);

        // OPEN MY INFO AGAIN

        homePage.clickMyInfo();

        // VERIFY UPDATED DETAILS

        String actualFirstName = myInfoPage.getFirstName();

        String actualLastName = myInfoPage.getLastName();

        String actualEmployeeId = myInfoPage.getEmployeeId();

        Assert.assertEquals( actualFirstName, firstName, "First Name is not updated");

        Assert.assertEquals( actualLastName, lastName, "Last Name is not updated");

        Assert.assertEquals( actualEmployeeId, employeeId, "Employee ID is not updated");

        System.out.println( "Employee details verified successfully");

        // FINAL LOGOUT

        homePage.logout();
    }
}

